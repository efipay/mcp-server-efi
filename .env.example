# Ambiente Efí: true para homologação; false para produção.
EFI_SANDBOX=true

# Credenciais da aplicação. Não use valores reais neste arquivo versionado.
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=

# Use um caminho absoluto para P12/PEM ou o conteúdo em base64.
EFI_CERTIFICATE=/caminho/absoluto/certificado.p12
EFI_PEM_KEY=
EFI_CERT_BASE64=false

# Opções do SDK.
EFI_PARTNER_TOKEN=
EFI_VALIDATE_MTLS=true
EFI_CACHE=true

# Omita para habilitar todas as APIs.
EFI_APIS=cobrancas,pix,open-finance,pagamento-contas,abertura-contas,extratos

# Saídas com certificado, credenciais ou chave privada ficam ocultas por padrão.
# Para habilitar, informe ambos e use somente os nomes necessários:
# EFI_SENSITIVE_TOOLS=create_account_certificate,get_account_credentials
# EFI_ACCEPT_SENSITIVE_OUTPUT_RISK=I_UNDERSTAND

# Limites conservadores por processo.
EFI_MAX_CONCURRENCY=4
EFI_MUTATION_MAX_CONCURRENCY=1
EFI_READ_RATE_PER_MINUTE=60
EFI_MUTATION_RATE_PER_MINUTE=10
EFI_SENSITIVE_RATE_PER_MINUTE=1
